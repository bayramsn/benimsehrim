// Prisma Schema for Benim Şehrim
// PostgreSQL Database Schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  USER
  VENDOR
  TAXI_DRIVER
  COURIER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  COURIER_ASSIGNED
  PICKED_UP
  DELIVERING
  DELIVERED
  CANCELLED
  REJECTED
}

enum RideStatus {
  SEARCHING
  DRIVER_ACCEPTED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_DRIVER
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  PICKED_UP
  ARRIVING
  DELIVERED
  FAILED
  CANCELLED
}

enum CampaignType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
  HAPPY_HOUR
  DAILY
  WEEKLY
}

enum PaymentType {
  CASH
  CARD
  IBAN
  ONLINE
}

enum TicketType {
  VENDOR_ISSUE
  TAXI_ISSUE
  COURIER_ISSUE
  ORDER_ISSUE
  PAYMENT_ISSUE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  PUSH
  SMS
  WHATSAPP
}

// ==================== CORE ENTITIES ====================

model City {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  latitude  Float?
  longitude Float?
  config    Json?    // Tenant configuration
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts District[]
  users     User[]
  stores    Store[]
  settings  Setting[]

  @@map("cities")
}

model District {
  id        String   @id @default(uuid())
  cityId    String
  name      String
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city  City   @relation(fields: [cityId], references: [id])
  users User[]

  @@map("districts")
}

model User {
  id         String   @id @default(uuid())
  phone      String   @unique
  email      String?
  password   String?
  name       String?
  avatarUrl  String?
  role       UserRole @default(USER)
  cityId     String?
  districtId String?
  points     Int      @default(0)  // Gamification points
  badges     Json?    // Array of badge IDs
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  city     City?     @relation(fields: [cityId], references: [id])
  district District? @relation(fields: [districtId], references: [id])

  addresses     Address[]
  stores        Store[]
  driver        Driver?
  courier       Courier?
  orders        Order[]
  taxiRides     TaxiRide[]
  chats         Chat[]           @relation("UserChats")
  chatPartner   Chat[]           @relation("PartnerChats")
  messages      Message[]
  reviews       Review[]
  tickets       Ticket[]
  notifications Notification[]
  pushTokens    PushToken[]
  userFeatures  UserFeature[]
  adminLogs     AdminLog[]
  
  // New features
  referralCode     String?  @unique
  referredBy       String?
  preferences      Json?
  referralsGiven   Referral[]         @relation("ReferrerReferrals")
  referralsReceived Referral[]        @relation("RefereeReferrals")
  dailyTaskProgress DailyTaskProgress[]
  qrPayments       QRPayment[]
  
  // Yeni özellikler
  premiumSubscriptions PremiumSubscription[]
  wallet               Wallet?
  spinHistory          SpinHistory[]
  coupons              UserCoupon[]
  favoriteLists        FavoriteList[]
  bulkOrders           BulkOrder[]
  chatHistory          ChatHistory[]

  @@index([phone])
  @@index([role])
  @@index([cityId])
  @@index([referralCode])
  @@map("users")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  title     String
  address   String
  latitude  Float
  longitude Float
  note      String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// ==================== VENDOR MODULE ====================

model Category {
  id        String   @id @default(uuid())
  name      String
  icon      String?
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  stores   Store[]    @relation("StoreCategories")

  @@map("categories")
}

model Store {
  id           String        @id @default(uuid())
  userId       String
  cityId       String
  name         String
  description  String?
  logoUrl      String?
  bannerUrl    String?
  address      String
  latitude     Float
  longitude    Float
  phone        String?
  isOpen       Boolean       @default(true)
  openTime     String        @default("08:00")
  closeTime    String        @default("22:00")
  isApproved   Boolean       @default(false)
  isFeatured   Boolean       @default(false)  // For ads/promotion
  paymentTypes PaymentType[]
  iban         String?
  minOrder     Float         @default(0)
  deliveryFee  Float         @default(0)
  rating       Float         @default(0)
  reviewCount  Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  city           City            @relation(fields: [cityId], references: [id])
  categories     Category[]      @relation("StoreCategories")
  products       Product[]
  campaigns      Campaign[]
  orders         Order[]
  reviews        Review[]        @relation("StoreReviews")
  advertisements Advertisement[]
  qrPayments     QRPayment[]
  
  // Yeni özellikler
  stories        Story[]
  bulkOrders     BulkOrder[]
  pricingRules   PricingRule[]

  // Operasyonel Özellikler
  isBusy         Boolean       @default(false)
  busyAutoMode   Boolean       @default(true)
  cancelCount    Int           @default(0) // Kriz alarmı için
  usageScore     Float         @default(0) // Kullanım skoru
  notes          Json?         // Saha notları (CRM)

  @@index([userId])
  @@index([cityId])
  @@index([isOpen])
  @@index([isApproved])
  @@map("stores")
}

model Product {
  id          String   @id @default(uuid())
  storeId     String
  categoryId  String?
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  unit        String?
  images      String[]
  isActive    Boolean  @default(true)
  lastSoldAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id])
  campaigns  Campaign[]
  orderItems OrderItem[]

  @@index([storeId])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model Campaign {
  id            String       @id @default(uuid())
  storeId       String
  productId     String?
  type          CampaignType
  value         Float
  startDate     DateTime
  endDate       DateTime
  stockLimit    Int?
  usedStock     Int          @default(0)
  happyHourStart String?
  happyHourEnd  String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@index([storeId])
  @@index([productId])
  @@index([isActive])
  @@index([endDate])
  @@map("campaigns")
}

// ==================== ORDER MODULE ====================

model Order {
  id           String      @id @default(uuid())
  orderNo      String      @unique
  userId       String
  storeId      String
  courierId    String?
  addressId    String
  status       OrderStatus @default(PENDING)
  subtotal     Float
  discount     Float       @default(0)
  deliveryFee  Float       @default(0)
  total        Float
  addressNote  String?
  paymentType  PaymentType
  paymentStatus String     @default("PENDING")
  notifCount   Int         @default(0)
  createdAt    DateTime    @default(now())
  acceptedAt   DateTime?
  deliveredAt  DateTime?
  updatedAt    DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  store    Store       @relation(fields: [storeId], references: [id])
  courier  Courier?    @relation(fields: [courierId], references: [id])
  address  Address     @relation(fields: [addressId], references: [id])
  items    OrderItem[]
  timeline OrderTimeline[]
  notifications OrderNotification[]
  delivery Delivery?
  chat     Chat?
  reviews  Review[]

  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  campaignId  String?
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@map("order_items")
}

model OrderTimeline {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdBy String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_timeline")
}

model OrderNotification {
  id         String           @id @default(uuid())
  orderId    String
  type       NotificationType
  sentAt     DateTime         @default(now())
  respondedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_notifications")
}

// ==================== TAXI MODULE ====================

model Driver {
  id           String   @id @default(uuid())
  userId       String   @unique
  vehiclePlate String
  vehicleModel String?
  vehicleColor String?
  licenseNo    String
  isOnline     Boolean  @default(false)
  isApproved   Boolean  @default(false)
  latitude     Float?
  longitude    Float?
  lastLocation DateTime?
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  dailyCancel  Int      @default(0)
  totalRides   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  rides     TaxiRide[]
  rideCalls RideCall[]
  reviews   Review[]   @relation("DriverReviews")

  // Operasyonel Özellikler
  isBusy         Boolean   @default(false)
  restModeEndsAt DateTime?
  dailyGoal      Int       @default(10)
  usageScore     Float     @default(0)
  notes          Json?     // Saha notları

  @@index([isOnline])
  @@index([isApproved])
  @@map("drivers")
}

model TaxiRide {
  id            String     @id @default(uuid())
  userId        String
  driverId      String?
  status        RideStatus @default(SEARCHING)
  pickupLat     Float
  pickupLng     Float
  pickupAddress String
  dropLat       Float
  dropLng       Float
  dropAddress   String
  estDistance   Float?
  estDuration   Int?
  estFare       Float?
  actualFare    Float?
  createdAt     DateTime   @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  updatedAt     DateTime   @updatedAt

  user      User           @relation(fields: [userId], references: [id])
  driver    Driver?        @relation(fields: [driverId], references: [id])
  timeline  RideTimeline[]
  calls     RideCall[]
  chat      Chat?
  reviews   Review[]

  @@index([userId])
  @@index([driverId])
  @@index([status])
  @@map("taxi_rides")
}

model RideTimeline {
  id        String     @id @default(uuid())
  rideId    String
  status    RideStatus
  latitude  Float?
  longitude Float?
  createdAt DateTime   @default(now())

  ride TaxiRide @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@map("ride_timeline")
}

model RideCall {
  id          String    @id @default(uuid())
  rideId      String
  driverId    String
  status      String    @default("PENDING")
  sentAt      DateTime  @default(now())
  respondedAt DateTime?

  ride   TaxiRide @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver Driver   @relation(fields: [driverId], references: [id])

  @@map("ride_calls")
}

// ==================== COURIER MODULE ====================

model Courier {
  id           String   @id @default(uuid())
  userId       String   @unique
  vehicleType  String?
  isOnline     Boolean  @default(false)
  isApproved   Boolean  @default(false)
  latitude     Float?
  longitude    Float?
  lastLocation DateTime?
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  dailyCount   Int      @default(0)
  dailyReject  Int      @default(0)
  maxDaily     Int      @default(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  orders     Order[]
  deliveries Delivery[]
  reviews    Review[]   @relation("CourierReviews")

  // Operasyonel Özellikler
  isBusy         Boolean   @default(false)
  restModeEndsAt DateTime?
  dailyGoal      Int       @default(15)
  usageScore     Float     @default(0)
  notes          Json?     // Saha notları

  @@index([isOnline])
  @@index([isApproved])
  @@map("couriers")
}

model Delivery {
  id           String         @id @default(uuid())
  orderId      String         @unique
  courierId    String?
  status       DeliveryStatus @default(PENDING)
  pickupAddr   String?
  pickupLat    Float?
  pickupLng    Float?
  dropAddr     String?
  dropLat      Float?
  dropLng      Float?
  estDuration  Int?
  pickedAt     DateTime?
  arrivedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  order    Order              @relation(fields: [orderId], references: [id])
  courier  Courier?           @relation(fields: [courierId], references: [id])
  timeline DeliveryTimeline[]
  assigns  DeliveryAssign[]

  @@index([courierId])
  @@index([status])
  @@map("deliveries")
}

model DeliveryTimeline {
  id         String         @id @default(uuid())
  deliveryId String
  status     DeliveryStatus
  latitude   Float?
  longitude  Float?
  createdAt  DateTime       @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("delivery_timeline")
}

model DeliveryAssign {
  id          String    @id @default(uuid())
  deliveryId  String
  courierId   String
  status      String    @default("PENDING")
  sentAt      DateTime  @default(now())
  respondedAt DateTime?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("delivery_assigns")
}

// ==================== CHAT MODULE ====================

model Chat {
  id        String    @id @default(uuid())
  type      String    // ORDER, RIDE
  orderId   String?   @unique
  rideId    String?   @unique
  userId    String
  partnerId String
  isActive  Boolean   @default(true)
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order    Order?    @relation(fields: [orderId], references: [id])
  ride     TaxiRide? @relation(fields: [rideId], references: [id])
  user     User      @relation("UserChats", fields: [userId], references: [id])
  partner  User      @relation("PartnerChats", fields: [partnerId], references: [id])
  messages Message[]

  @@map("chats")
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@index([chatId])
  @@map("messages")
}

// ==================== REVIEW MODULE ====================

model Review {
  id         String   @id @default(uuid())
  userId     String
  targetType String   // STORE, DRIVER, COURIER
  targetId   String
  orderId    String?
  rideId     String?
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id])
  order   Order?    @relation(fields: [orderId], references: [id])
  ride    TaxiRide? @relation(fields: [rideId], references: [id])
  store   Store?    @relation("StoreReviews", fields: [targetId], references: [id], map: "store_reviews")
  driver  Driver?   @relation("DriverReviews", fields: [targetId], references: [id], map: "driver_reviews")
  courier Courier?  @relation("CourierReviews", fields: [targetId], references: [id], map: "courier_reviews")

  @@index([targetType, targetId])
  @@map("reviews")
}

// ==================== SUPPORT MODULE ====================

model Ticket {
  id          String       @id @default(uuid())
  ticketNo    String       @unique
  userId      String
  type        TicketType
  orderId     String?
  rideId      String?
  deliveryId  String?
  subject     String
  description String?
  status      TicketStatus @default(OPEN)
  priority    Int          @default(1)
  assignedTo  String?
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime     @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  replies TicketReply[]

  @@index([userId])
  @@index([status])
  @@map("tickets")
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  content   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_replies")
}

// ==================== NOTIFICATION MODULE ====================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   // android, ios
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_tokens")
}

// ==================== FEATURE FLAGS ====================

model FeatureFlag {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  description  String?
  defaultValue Boolean  @default(false)
  isPremium    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userFeatures UserFeature[]

  @@map("feature_flags")
}

model UserFeature {
  id        String    @id @default(uuid())
  userId    String
  flagKey   String
  enabled   Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flag FeatureFlag @relation(fields: [flagKey], references: [key])

  @@unique([userId, flagKey])
  @@map("user_features")
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  price         Float    @default(0)
  billingPeriod String?  // monthly, yearly
  features      Json     // Array of feature flag keys
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("subscription_plans")
}

// ==================== ADMIN MODULE ====================

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@map("admin_logs")
}

model Setting {
  id        String   @id @default(uuid())
  key       String
  value     String
  cityId    String?
  updatedAt DateTime @updatedAt

  city City? @relation(fields: [cityId], references: [id])

  @@unique([key, cityId])
  @@map("settings")
}

// ==================== GAMIFICATION MODULE ====================

model PointHistory {
  id        String   @id @default(uuid())
  userId    String
  points    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("point_history")
}

// ==================== ADVERTISEMENT MODULE ====================

model Advertisement {
  id            String    @id @default(uuid())
  storeId       String
  cityId        String?
  categoryId    String?
  position      String    // HOME_BANNER, CATEGORY_TOP, STORE_LIST, SEARCH_RESULTS
  title         String
  description   String?
  imageUrl      String
  targetUrl     String?
  badge         String?   // "Sponsorlu", "Reklam"
  bidAmount     Float     @default(0)
  dailyBudget   Float?
  dailySpent    Float     @default(0)
  impressions   Int       @default(0)
  clicks        Int       @default(0)
  priority      Int       @default(0)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  store    Store     @relation(fields: [storeId], references: [id])
  adClicks AdClick[]

  @@index([storeId])
  @@index([position])
  @@index([isActive])
  @@map("advertisements")
}

model AdClick {
  id              String   @id @default(uuid())
  advertisementId String
  userId          String?
  clickedAt       DateTime @default(now())

  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  @@index([advertisementId])
  @@map("ad_clicks")
}

// ==================== NEW FEATURES ====================

// Referans Sistemi
model Referral {
  id             String    @id @default(uuid())
  referrerId     String    // Davet eden
  refereeId      String    // Davet edilen
  status         String    @default("PENDING") // PENDING, COMPLETED, EXPIRED
  referrerReward Float     @default(20)
  refereeReward  Float     @default(10)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  referrer User @relation("ReferrerReferrals", fields: [referrerId], references: [id])
  referee  User @relation("RefereeReferrals", fields: [refereeId], references: [id])

  @@index([referrerId])
  @@index([refereeId])
  @@index([status])
  @@map("referrals")
}

// Günlük Görev İlerlemesi
model DailyTaskProgress {
  id             String   @id // userId_date format
  userId         String
  date           DateTime
  completedTasks Json     @default("[]") // Array of task IDs
  referralShared Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
  @@map("daily_task_progress")
}

// QR Ödeme
model QRPayment {
  id            String    @id @default(uuid())
  code          String    @unique
  storeId       String?
  userId        String?
  amount        Float?
  maxAmount     Float?
  isUserQR      Boolean   @default(false)
  status        String    @default("PENDING") // PENDING, COMPLETED, EXPIRED, CANCELLED
  paymentMethod String?   // cash, card, points
  transactionId String?
  expiresAt     DateTime
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  store Store? @relation(fields: [storeId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])

  @@index([code])
  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@map("qr_payments")
}

// ==================== YENI ÖZELLİKLER ====================

// Arama Logları
model SearchLog {
  id          String   @id @default(uuid())
  query       String
  resultCount Int      @default(0)
  userId      String?
  createdAt   DateTime @default(now())

  @@index([query])
  @@index([createdAt])
  @@map("search_logs")
}

// Premium Abonelik
model PremiumSubscription {
  id            String    @id @default(uuid())
  userId        String
  planId        String
  price         Float
  status        String    @default("ACTIVE") // ACTIVE, CANCELLED, EXPIRED
  paymentMethod String?
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("premium_subscriptions")
}

// Cüzdan
model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Float    @default(0)
  pendingBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  type        String   // DEPOSIT, WITHDRAWAL, PAYMENT, REFUND, CASHBACK, POINTS_CONVERSION
  amount      Float
  description String
  status      String   @default("COMPLETED")
  referenceId String?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([type])
  @@map("wallet_transactions")
}

// Çark Çevir
model SpinHistory {
  id         String   @id @default(uuid())
  userId     String
  prizeId    String
  prizeName  String
  prizeType  String
  prizeValue Float    @default(0)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("spin_history")
}

// Kuponlar
model UserCoupon {
  id        String   @id @default(uuid())
  userId    String
  code      String   @unique
  type      String   // PERCENTAGE, FIXED, FREE_DELIVERY
  value     Float
  minOrder  Float?
  expiresAt DateTime
  usedAt    DateTime?
  source    String?  // SPIN_WHEEL, REFERRAL, CAMPAIGN
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([code])
  @@map("user_coupons")
}

// Hikayeler
model Story {
  id         String   @id @default(uuid())
  storeId    String
  mediaUrl   String
  mediaType  String   // image, video
  caption    String?
  linkType   String?  // product, campaign, store
  linkId     String?
  viewCount  Int      @default(0)
  clickCount Int      @default(0)
  expiresAt  DateTime
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  store Store       @relation(fields: [storeId], references: [id])
  views StoryView[]

  @@index([storeId])
  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("story_views")
}

// Favori Listeler
model FavoriteList {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  shareCode   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id])
  items FavoriteItem[]

  @@index([userId])
  @@map("favorite_lists")
}

model FavoriteItem {
  id        String   @id @default(uuid())
  listId    String
  itemType  String   // product, store
  itemId    String
  name      String
  note      String?
  createdAt DateTime @default(now())

  list FavoriteList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@map("favorite_items")
}

// Yorum Helpful
model ReviewHelpful {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@map("review_helpful")
}

// Toplu Sipariş
model BulkOrder {
  id                 String    @id @default(uuid())
  userId             String
  storeId            String
  eventType          String    // WEDDING, FUNERAL, BIRTHDAY, CORPORATE, OTHER
  eventDate          DateTime
  guestCount         Int
  items              Json
  notes              String?
  contactPhone       String
  deliveryAddress    String
  originalTotal      Float
  discountPercentage Float     @default(0)
  discountedTotal    Float
  deliveryFee        Float     @default(0)
  grandTotal         Float
  quoteValidUntil    DateTime
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED, PAID, COMPLETED
  rejectionReason    String?
  approvedAt         DateTime?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@map("bulk_orders")
}

// Dinamik Fiyatlandırma Kuralları
model PricingRule {
  id                 String   @id @default(uuid())
  storeId            String
  type               String   // TIME_BASED, DEMAND_BASED, STOCK_BASED, LOYALTY
  name               String
  discountPercentage Float
  conditions         Json
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([type])
  @@map("pricing_rules")
}

// Chatbot Geçmişi
model ChatHistory {
  id        String   @id @default(uuid())
  userId    String
  messages  Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("chat_history")
}

// ==================== SYSTEM & GROWTH ====================

model CrisisLog {
  id         String   @id @default(uuid())
  type       String   // STORE_CANCEL, DRIVER_REJECT, COURIER_DELAY
  targetType String   // STORE, DRIVER, COURIER
  targetId   String
  severity   String   // LOW, MEDIUM, HIGH
  message    String
  isActive   Boolean  @default(true) // Admin çözünce false olur
  details    Json?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([isActive])
  @@index([type])
  @@map("crisis_logs")
}

model CityTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  config      Json     // Varsayılan ayarlar, kategoriler, roller
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("city_templates")
}
