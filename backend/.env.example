# Environment Configuration
# Copy this file to .env.development or .env.production

# ===========================================
# APP
# ===========================================
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/benimsehrim?schema=public"

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# JWT
# ===========================================
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# SMS PROVIDER
# Options: mock, twilio, netgsm
# ===========================================
SMS_PROVIDER=mock

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# NetGSM (Türkiye)
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=BENIMSEHRIM

# ===========================================
# WHATSAPP PROVIDER
# Options: mock, twilio, meta
# ===========================================
WHATSAPP_PROVIDER=mock

# Meta WhatsApp Business API
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=

# ===========================================
# FIREBASE (Push Notifications)
# Get these from Firebase Console > Project Settings > Service Accounts
# ===========================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ===========================================
# GOOGLE MAPS
# ===========================================
GOOGLE_MAPS_API_KEY=

# ===========================================
# FILE STORAGE
# Options: local, s3
# ===========================================
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=benimsehrim-uploads
